# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MongoDB and JWT
MONGODB_URI=mongodb://127.0.0.1:27017/payflow
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/stripe/refresh
STRIPE_PLATFORM_FEE_PERCENT=0
# Configure Stripe Billing customer-portal and customer-email settings in Dashboard.

# Resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM_NAME=PayFlow
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_FOLDER=payflow/profiles

# Vite (copy these two entries to client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
